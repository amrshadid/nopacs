{
  "name": "nopacs",
  "version": "0.0.0",
  "description": "TypeScript client for the NoPACs research imaging archive's API",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/browser.js",
  "types": "./dist/browser.d.ts",
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./gen/*": {
      "types": "./dist/gen/nopacs/v1/*.d.ts",
      "default": "./dist/gen/nopacs/v1/*.js"
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-node": "2.3.0",
    "@connectrpc/connect-web": "2.3.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@types/node": "^22.20.5",
    "typescript": "5.9.3",
    "vitest": "^5.1.1"
  }
}
